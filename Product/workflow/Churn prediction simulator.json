    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const data = item.json;\n\n  let decision;\n\n  if (data.action === \"premium_retention_offer\") {\n    decision = \"Send premium retention offer\";\n  } else if (data.action === \"email_campaign\") {\n    decision = \"Send email campaign\";\n  } else {\n    decision = \"No action\";\n  }\n\n  return {\n    json: {\n      ...data,\n      decision\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        0
      ],
