    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const d = item.json;\n\n  return {\n    json: {\n      CreditScore: Number(d.CreditScore),\n      Geography: d.Geography,\n      Gender: d.Gender,\n      Age: Number(d.Age),\n      Tenure: Number(d.Tenure),\n      Balance: Number(d.Balance),\n      NumOfProducts: Number(d.NumOfProducts),\n      HasCrCard: Number(d.HasCrCard),\n      IsActiveMember: Number(d.IsActiveMember),\n      EstimatedSalary: Number(d.EstimatedSalary),\n      Complain: Number(d.Complain),\n\n      // 🔥 FIXED NAMES\n      Satisfaction_Score: Number(d[\"Satisfaction Score\"]),\n      Card_Type: d[\"Card Type\"],\n      Point_Earned: Number(d[\"Point Earned\"])\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
