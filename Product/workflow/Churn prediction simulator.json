      ],
      "id": "01248e86-05e3-4748-8155-99b30a4bd2a3",
      "name": "Tracking code"
    },
    {
      "parameters": {
        "jsCode": "return items.filter(item => {\n  const d = item.json;\n\n  return (\n    d.CreditScore !== undefined &&\n    d.Geography !== undefined &&\n    d.Age !== undefined\n  );\n});"
      },
      "type": "n8n-nodes-base.code",
