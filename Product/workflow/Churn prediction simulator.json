      "id": "2b93f9dd-8a7b-4b8c-816e-7e25530e4ecc",
      "name": "changing field's names "
    },
    {
      "parameters": {
        "jsCode": "const requestId = Date.now().toString();\n\nreturn items.map(item => {\n  return {\n    json: {\n      ...item.json,\n\n      //  tracking fields\n      timestamp: new Date().toISOString(),\n      request_id: requestId,\n      model_version: \"v1\"\n    }\n  };\n});"
      },
